# Copy this file to .env and fill in real values — .env itself is gitignored.
# IMPORTANT: if a URL contains a "#" (hash-based routing), wrap the value in
# double quotes — otherwise dotenv treats everything after "#" as a comment
# and silently truncates the URL.
BASE_URL=
STUB_URL=

# Optional — set to "production" on the command line to run against production
# instead of QA (e.g. TEST_ENV=production npx playwright test). Leave unset for QA.
# TEST_ENV=

# Only required when TEST_ENV=production
PROD_BASE_URL=
PROD_EMAIL=
PROD_PASSWORD=
